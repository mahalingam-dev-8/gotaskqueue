# Copy to .env and adjust. Every setting has a sane default except the two
# marked REQUIRED.

# ---- shared ----
APP_ENV=development                 # development | staging | production
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | text

# REQUIRED
DATABASE_URL=postgres://gotaskqueue:gotaskqueue@localhost:5432/gotaskqueue?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=10s
RUN_MIGRATIONS=true                 # true on the API, false on workers

# ---- cmd/api ----
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
DEFAULT_MAX_ATTEMPTS=5

# REQUIRED, min 32 chars
JWT_SECRET=local-dev-secret-change-me-0123456789
JWT_ISSUER=gotaskqueue
JWT_AUDIENCE=gotaskqueue-api
JWT_TTL=1h

# ---- cmd/worker ----
WORKER_POOL_SIZE=5
WORKER_POLL_INTERVAL=1s
WORKER_JOB_TIMEOUT=30s
RETRY_BASE_BACKOFF=5s
RETRY_MAX_BACKOFF=10m
STUCK_JOB_TIMEOUT=5m
RECOVERY_INTERVAL=1m
WORKER_SHUTDOWN_GRACE=30s
# WORKER_ID=                        # defaults to the hostname
